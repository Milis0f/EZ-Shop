# Copy to .env.local and fill in what you have. Never commit .env.local.
# Every connector left empty stays "not configured": its indicators show DATA_INSUFFICIENT.

# ---- Database ----
# Empty → embedded PGlite in PGLITE_DATA_DIR (zero install, auto-migrated).
# Supabase / Postgres → set the connection string, then run `npm run db:migrate`.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# ---- Development fixtures ----
# Mock data is allowed by default outside production. Set to false to hide it.
# ALLOW_MOCK_DATA=true
PROVIDER_HTTP_TIMEOUT_MS=12000

# ---- Google Trends API (alpha, access on application) ----
# https://developers.google.com/search/apis/trends
GOOGLE_TRENDS_API_KEY=

# ---- Google Ads API — Keyword Planning ----
# https://developers.google.com/google-ads/api/docs/keyword-planning/overview
# API version as listed in https://developers.google.com/google-ads/api/docs/release-notes (e.g. "v2X").
# No developer token: sunset on 2026-09-09. API access (Test / Explorer / Basic / Standard) belongs to the
# Google Cloud project that owns the OAuth client; Keyword Planning requires Basic or Standard.
# https://console.cloud.google.com/google/ads-apis/overview
GOOGLE_ADS_API_VERSION=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Account used for Keyword Planner requests (digits, dashes allowed).
GOOGLE_ADS_CUSTOMER_ID=
# Manager account, only if access goes through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Meta Ad Library API ----
# https://developers.facebook.com/docs/graph-api/reference/ads_archive/
# Graph API version, e.g. "v2X.0".
META_GRAPH_API_VERSION=
META_AD_LIBRARY_ACCESS_TOKEN=

# ---- TikTok Commercial Content API (research access) ----
# https://developers.tiktok.com/doc/commercial-content-api-getting-started/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Not implemented yet (see src/providers/ad-cost/adapters.ts) ----
# META_MARKETING_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# TIKTOK_BUSINESS_ACCESS_TOKEN=
# TIKTOK_ADVERTISER_ID=

# ---- Data sources v2: free, account required (guided setup in Sources de données > Configurer) ----
# YouTube Data API v3: a Google Cloud API key with the API enabled (10 000 free units per day).
YOUTUBE_API_KEY=
# eBay Browse API: Production keyset, App ID = client id, Cert ID = client secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# AliExpress Affiliate API: Open Platform app key/secret, affiliate tracking ID (optional but recommended).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Open sources used without any key: Google Autocomplete (unofficial), Wikipedia/Wikidata,
# GOV.UK Trade Tariff (GB + EU tariff), USITC HTS, vatcomply VAT rates, ECB FX (Frankfurter).
